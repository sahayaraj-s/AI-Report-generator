# ==============================================================
# Skill Bay Academy — AI Placement Analytics Platform
# Root Environment Template
# ==============================================================
# Copy backend/.env.example to backend/.env
# Copy frontend/.env.example to frontend/.env
#
# NEVER COMMIT REAL .env FILES, SERVICE ACCOUNTS, OR API KEYS TO GIT.

# Backend (see backend/.env.example for details)
DEV_MODE=False
DATABASE_URL=sqlite:///./placement.db
FIREBASE_SERVICE_ACCOUNT_JSON=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=8.0
CORS_ORIGINS=https://skill-bay-ai.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=https://skill-bay-ai.vercel.app

# Frontend (see frontend/.env.example for details)
VITE_DEV_MODE=false
VITE_API_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
