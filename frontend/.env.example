# ==============================================================
# AI Placement Dashboard — Frontend environment variables
# Copy to .env and fill in with your real Firebase project's web config
# (Firebase Console -> Project Settings -> General -> Your apps -> SDK setup and config)
# ==============================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Set to true ONLY for local development without a Firebase project.
# In production, VITE_DEV_MODE MUST be false.
# Must match DEV_MODE on the backend.
VITE_DEV_MODE=false

# Backend API URL (no trailing slash)
VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
