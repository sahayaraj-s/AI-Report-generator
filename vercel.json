{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://skill-bay-ai.onrender.com/api/$1"
    },
    {
      "source": "/docs(.*)",
      "destination": "https://skill-bay-ai.onrender.com/docs$1"
    },
    {
      "source": "/openapi.json",
      "destination": "https://skill-bay-ai.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
