# ==============================================================
# AI Placement Dashboard — Backend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git.
# ==============================================================

# --- App mode -------------------------------------------------
# When true: skips real Firebase token verification and treats every
# request as a logged-in admin. Lets you run and test the whole app
# locally with no Firebase project set up yet.
# Set to false the moment you connect a real Firebase project.
DEV_MODE=true

# --- Database ---------------------------------------------------
# Local dev default (no setup needed):
DATABASE_URL=sqlite:///./placement.db
# Swap in your real Postgres / Firebase Data Connect Postgres instance:
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# --- Firebase Admin SDK ----------------------------------------
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Paste the ENTIRE downloaded JSON as a single line here (DEV_MODE=false only).
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Gemini AI ---------------------------------------------------
# Leave blank to use the built-in local AI-summary generator (fully functional,
# just not powered by Gemini). Add a real key to switch on live Gemini calls.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- CORS ---------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173
